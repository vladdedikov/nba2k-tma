generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  telegram_id   String?       @unique
  username      String?
  role          String        @default("USER")
  
  owned_teams   Team[]
  insider_posts InsiderPost[]
}

model Team {
  id             String   @id @default(uuid())
  name           String
  logo_url       String?
  budget         Float    @default(0)
  salary_cap     Float    @default(140000000)

  owner_id       String?
  owner          User?    @relation(fields: [owner_id], references: [id])

  players        Player[]
  
  original_picks DraftPick[] @relation("OriginalTeamPicks")
  current_picks  DraftPick[] @relation("CurrentTeamPicks")

  trade_offers_sent     TradeOffer[] @relation("SentOffers")
  trade_offers_received TradeOffer[] @relation("ReceivedOffers")

  free_agency_lots_won  FreeAgencyLot[] @relation("HighestBidder")
  insider_posts         InsiderPost[]
}

model Player {
  id                  String   @id @default(uuid())
  name                String
  position            String
  overall_rating      Int
  salary              Float
  salaries            Float[]
  contract_years_left Int
  option_type         String   @default("NONE")
  
  team_id             String?
  team                Team?    @relation(fields: [team_id], references: [id])
  previous_team_id    String?

  free_agency_lots    FreeAgencyLot[]
}

model LeagueSettings {
  id            Int   @id @default(1)
  soft_cap      Float @default(140.0)
  luxury_tax    Float @default(170.0)
  first_apron   Float @default(178.0)
  second_apron  Float @default(189.0)
  hard_cap      Float @default(200.0)
  current_stage String @default("REGULAR_SEASON")
}

model DraftPick {
  id               String   @id @default(uuid())
  original_team_id String
  original_team    Team     @relation("OriginalTeamPicks", fields: [original_team_id], references: [id])
  current_team_id  String
  current_team     Team     @relation("CurrentTeamPicks", fields: [current_team_id], references: [id])
  
  year             Int
  round            Int
  protected_rules  String?
}

model TradeOffer {
  id                  String   @id @default(uuid())
  sender_team_id      String
  receiver_team_id    String
  status              String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  message             String?
  created_at          DateTime @default(now())

  sent_player_ids     String[]
  received_player_ids String[]
  sent_pick_ids       String[]
  received_pick_ids   String[]

  sender_team   Team @relation("SentOffers", fields: [sender_team_id], references: [id])
  receiver_team Team @relation("ReceivedOffers", fields: [receiver_team_id], references: [id])
}

model InsiderPost {
  id         String   @id @default(uuid())
  author_id  String?
  author     User?    @relation(fields: [author_id], references: [id])
  team_id    String?
  team       Team?    @relation(fields: [team_id], references: [id])
  
  content    String
  created_at DateTime @default(now())
}

model FreeAgencyLot {
  id                     String   @id @default(uuid())
  batch_number           Int
  player_id              String
  player                 Player   @relation(fields: [player_id], references: [id])
  
  current_highest_bid    Float    @default(0)
  highest_bidder_team_id String?
  highest_bidder_team    Team?    @relation("HighestBidder", fields: [highest_bidder_team_id], references: [id])
  
  expires_at             DateTime
  status                 String   @default("OPEN")
}
