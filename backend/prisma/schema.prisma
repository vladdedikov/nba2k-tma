generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  telegram_id   String?       @unique
  username      String?
  role          String        @default("USER")
  
  owned_teams   Team[]
  insider_posts InsiderPost[]
}

model Team {
  id             String   @id @default(uuid())
  name           String
  logo_url       String?
  budget         Float    @default(0)
  salary_cap     Float    @default(140000000)

  owner_id       String?
  owner          User?    @relation(fields: [owner_id], references: [id])

  players        Player[]
  contract_offers ContractOffer[]
  
  draft_picks    DraftPick[]

  trade_offers_sent     TradeOffer[] @relation("SentOffers")
  trade_offers_received TradeOffer[] @relation("ReceivedOffers")

  free_agency_lots_won  FreeAgencyLot[] @relation("HighestBidder")
  insider_posts         InsiderPost[]
}

model Player {
  id                  String   @id @default(uuid())
  name                String
  position            String
  overall_rating      Int
  salary              Float
  salaries            Float[]
  contract_years_left Int
  option_type         String   @default("NONE")
  
  team_id             String?
  team                Team?    @relation(fields: [team_id], references: [id])
  previous_team_id    String?

  is_prospect         Boolean  @default(false)
  is_trade_restricted Boolean  @default(false)
  is_rfa              Boolean  @default(false)
  fa_block_id         Int?
  fa_block            FaBlock? @relation(fields: [fa_block_id], references: [id])

  free_agency_lots    FreeAgencyLot[]
  contract_offers     ContractOffer[]
  drafted_in_picks    DraftPick[]
}

model ContractOffer {
  id            String   @id @default(uuid())
  player_id     String
  player        Player   @relation(fields: [player_id], references: [id])
  team_id       String
  team          Team     @relation(fields: [team_id], references: [id])
  years         Int      @default(1)
  annual_salary Float
  salaries      Float[]
  status        String   @default("PENDING")
  created_at    DateTime @default(now())
}

model LeagueSettings {
  id                     Int     @id @default(1)
  soft_cap               Float   @default(140.0)
  luxury_tax             Float   @default(170.0)
  first_apron            Float   @default(178.0)
  second_apron           Float   @default(189.0)
  hard_cap               Float   @default(200.0)
  current_stage          String  @default("REGULAR_SEASON")
  current_season         String  @default("2026-27")
  
  draft_order_approved   Boolean @default(false)
  current_draft_pick_index Int   @default(0)
  draft_is_completed     Boolean @default(false)

  min_salary_schedule    Float[]
  tax_mle_schedule       Float[]
  full_mle_schedule      Float[]
  rookie_max_schedule    Float[]
  medium_max_schedule    Float[]
  veteran_max_schedule   Float[]
  supermax_schedule      Float[]

  approved_fa_blocks     Int[]    @default([])
  completed_fa_blocks    Int[]    @default([])
  current_block_deadline DateTime?
  current_block_number   Int?
}

model DraftPick {
  id                 Int      @id @default(autoincrement())
  year               Int
  name               String
  team_id            String
  team               Team     @relation(fields: [team_id], references: [id], onDelete: Cascade)
  is_used            Boolean  @default(false)
  selected_player_id String?
  selected_player    Player?  @relation(fields: [selected_player_id], references: [id])
  created_at         DateTime @default(now())
}

model TradeOffer {
  id                  String   @id @default(uuid())
  sender_team_id      String
  receiver_team_id    String
  status              String   @default("PENDING") // PENDING, ACCEPTED, REJECTED, CANCELLED
  message             String?
  created_at          DateTime @default(now())

  sent_player_ids     String[]
  received_player_ids String[]
  sent_pick_ids       Int[]
  received_pick_ids   Int[]

  sender_team   Team @relation("SentOffers", fields: [sender_team_id], references: [id])
  receiver_team Team @relation("ReceivedOffers", fields: [receiver_team_id], references: [id])
}

model InsiderPost {
  id         String   @id @default(uuid())
  author_id  String?
  author     User?    @relation(fields: [author_id], references: [id])
  team_id    String?
  team       Team?    @relation(fields: [team_id], references: [id])
  
  content    String
  created_at DateTime @default(now())
}

model FreeAgencyLot {
  id                     String   @id @default(uuid())
  batch_number           Int
  player_id              String
  player                 Player   @relation(fields: [player_id], references: [id])
  
  current_highest_bid    Float    @default(0)
  highest_bidder_team_id String?
  highest_bidder_team    Team?    @relation("HighestBidder", fields: [highest_bidder_team_id], references: [id])
  
  expires_at             DateTime
  status                 String   @default("OPEN")
}

model FaBlock {
  id Int @id @default(autoincrement())
  number Int
  status String @default("PENDING")
  deadline DateTime?
  players Player[]
}
